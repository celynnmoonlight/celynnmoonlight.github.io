{
  "name": "hugo-blox-academic-cv-starter",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "description": "SihuangTech company profile and FlagSay product website powered by Hugo and Tailwind CSS v4",
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo --minify && pnpm run pagefind",
    "pagefind": "pagefind --site public"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "pagefind": "^1.5.2",
    "preact": "^11.0.0",
    "tailwindcss": "^4.3.3"
  }
}
